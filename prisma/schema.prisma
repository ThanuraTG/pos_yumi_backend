datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. SECURITY & USER MANAGEMENT
// -------------------------------------------------------------

model User {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  roles            UserRole[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  cashSessions     CashSession[]
  sales            Sale[]              @relation("CashierSales")
  salesProcessed   SalesReturn[]       @relation("ReturnProcessedBy")
  salesApproved    SalesReturn[]       @relation("ReturnApprovedBy")
  purchases        Purchase[]          @relation("PurchaseCreatedBy")
  supplierPayments SupplierPayment[]   @relation("SupplierPaymentCreatedBy")
  expenses         Expense[]
  stockMovements   StockMovement[]
  adjustmentsMade  StockAdjustment[]   @relation("AdjCreatedBy")
  adjApproved      StockAdjustment[]   @relation("AdjApprovedBy")

  @@map("users")
}

model Role {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @unique @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId BigInt @map("user_id") @db.UnsignedBigInt
  roleId BigInt @map("role_id") @db.UnsignedBigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       BigInt @map("role_id") @db.UnsignedBigInt
  permissionId BigInt @map("permission_id") @db.UnsignedBigInt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt?  @map("user_id") @db.UnsignedBigInt
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   BigInt?  @map("entity_id") @db.UnsignedBigInt
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  beforeData Json?    @map("before_state")
  afterData  Json?    @map("after_state")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// 2. MEDICINE MASTER & PACKAGING
// -------------------------------------------------------------

model Category {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @unique @db.VarChar(100)
  code        String   @unique @db.VarChar(30)
  description String?  @db.Text
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  medicines     Medicine[]
  subCategories SubCategory[]

  @@map("categories")
}

model SubCategory {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  categoryId  BigInt   @map("category_id") @db.UnsignedBigInt
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(50)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  medicines Medicine[]

  @@unique([categoryId, code])
  @@map("sub_categories")
}

model Manufacturer {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name         String   @unique @db.VarChar(150)
  country      String?  @db.VarChar(100)
  contactPhone String?  @map("contact_phone") @db.VarChar(50)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  medicines Medicine[]

  @@map("manufacturers")
}

model GenericMolecule {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name             String   @unique @db.VarChar(150)
  therapeuticClass String?  @map("therapeutic_class") @db.VarChar(100)
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  medicines Medicine[]

  @@map("generic_molecules")
}

enum DosageForm {
  TABLET
  CAPSULE
  SYRUP
  SUSPENSION
  INJECTION
  CREAM
  OINTMENT
  DROPS
  INHALER
  OTHER
}

model DosageFormMaster {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name          String   @unique @db.VarChar(100)
  categoryGroup String   @map("category_group") @db.VarChar(50)
  description   String?  @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  medicines     Medicine[]

  @@map("dosage_forms")
}

model SellingUnit {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name          String   @unique @db.VarChar(50)
  abbreviation  String   @db.VarChar(20)
  unitType      String   @default("COUNT") @map("unit_type") @db.VarChar(30)
  allowDecimals Boolean  @default(false) @map("allow_decimals")
  description   String?  @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  conversions   MedicinePackaging[] @relation("SellingUnitConversions")

  @@map("selling_units")
}

model PurchaseUnit {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name         String   @unique @db.VarChar(50)
  abbreviation String   @db.VarChar(20)
  description  String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  conversions  MedicinePackaging[] @relation("PurchaseUnitConversions")

  @@map("purchase_units")
}

model MedicinePackaging {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  medicineId       BigInt   @map("medicine_id") @db.UnsignedBigInt
  purchaseUnitId   BigInt?  @map("purchase_unit_id") @db.UnsignedBigInt
  purchaseUnitName String   @map("purchase_unit_name") @db.VarChar(50)
  packSize         String   @map("pack_size") @db.VarChar(100)
  conversionFactor Decimal  @map("conversion_factor") @db.Decimal(12, 3)
  baseUnitName     String   @map("base_unit_name") @db.VarChar(50)
  sellingUnitId    BigInt?  @map("selling_unit_id") @db.UnsignedBigInt
  sellingUnitName  String   @map("selling_unit_name") @db.VarChar(50)
  isDefault        Boolean  @default(true) @map("is_default")
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  medicine     Medicine      @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  purchaseUnit PurchaseUnit? @relation("PurchaseUnitConversions", fields: [purchaseUnitId], references: [id], onDelete: SetNull)
  sellingUnit  SellingUnit?  @relation("SellingUnitConversions", fields: [sellingUnitId], references: [id], onDelete: SetNull)

  @@index([medicineId])
  @@map("medicine_packaging")
}

model Medicine {
  id                   BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  categoryId           BigInt     @map("category_id") @db.UnsignedBigInt
  subCategory          String?    @map("sub_category") @db.VarChar(100)
  subCategoryId        BigInt?    @map("sub_category_id") @db.UnsignedBigInt
  dosageFormId         BigInt?    @map("dosage_form_id") @db.UnsignedBigInt
  manufacturerId       BigInt?    @map("manufacturer_id") @db.UnsignedBigInt
  genericId            BigInt?    @map("generic_id") @db.UnsignedBigInt
  supplierId           BigInt?    @map("supplier_id") @db.UnsignedBigInt
  name                 String     @db.VarChar(150)
  brandName            String     @map("brand_name") @db.VarChar(150)
  skuCode              String     @unique @map("sku_code") @db.VarChar(50)
  barcode              String?    @unique @db.VarChar(100)
  strength             String     @db.VarChar(50)
  dosageForm           DosageForm @map("dosage_form")
  composition          String?    @db.Text
  packSize             String?    @map("pack_size") @db.VarChar(50)
  baseUnit             String     @default("TABLET") @map("base_unit") @db.VarChar(30)
  purchaseUnit         String?    @map("purchase_unit") @db.VarChar(50)
  route                String?    @db.VarChar(50)
  prescriptionRequired Boolean    @default(false) @map("prescription_required")
  isNarcotic           Boolean    @default(false) @map("is_narcotic")
  reorderLevel         Decimal    @default(50.000) @map("reorder_level") @db.Decimal(12, 3)
  maxStockLevel        Decimal?   @map("max_stock_level") @db.Decimal(12, 3)
  rackLocation         String?    @map("rack_location") @db.VarChar(100)
  warehouseLocation    String?    @map("warehouse_location") @db.VarChar(100)
  storageCondition     String?    @map("storage_condition") @db.VarChar(100)
  purchasePrice        Decimal?   @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice         Decimal?   @map("selling_price") @db.Decimal(12, 2)
  wholesalePrice       Decimal?   @map("wholesale_price") @db.Decimal(12, 2)
  mrp                  Decimal?   @db.Decimal(12, 2)
  discountPercentage   Decimal    @default(0.00) @map("discount_percentage") @db.Decimal(5, 2)
  taxPercentage        Decimal    @default(0.00) @map("tax_percentage") @db.Decimal(5, 2)
  imageUrl             String?    @map("image_url") @db.VarChar(500)
  lowStockAlert        Boolean    @default(true) @map("low_stock_alert")
  expiryAlert          Boolean    @default(true) @map("expiry_alert")
  description          String?    @db.Text
  notes                String?    @db.Text
  isActive             Boolean    @default(true) @map("is_active")
  deletedAt            DateTime?  @map("deleted_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  category       Category          @relation(fields: [categoryId], references: [id])
  subCategoryRef SubCategory?      @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  dosageFormRef  DosageFormMaster? @relation(fields: [dosageFormId], references: [id], onDelete: SetNull)
  manufacturer   Manufacturer?     @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  generic        GenericMolecule?  @relation(fields: [genericId], references: [id], onDelete: SetNull)
  supplier       Supplier?         @relation("MedicinePrimarySupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  units         MedicineUnit[]
  packaging     MedicinePackaging[]
  batches       MedicineBatch[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  @@index([brandName])
  @@index([barcode])
  @@map("medicines")
}

model MedicineUnit {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  medicineId     BigInt   @map("medicine_id") @db.UnsignedBigInt
  unitName       String   @map("unit_name") @db.VarChar(50)
  baseUnitFactor Decimal  @map("base_unit_factor") @db.Decimal(12, 3)
  barcode        String?  @unique @db.VarChar(100)
  isSellable     Boolean  @default(true) @map("is_sellable")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  medicine  Medicine   @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]

  @@unique([medicineId, unitName], name: "uk_medicine_unit")
  @@map("medicine_units")
}

// -------------------------------------------------------------
// 3. BATCHES & INVENTORY LEDGER
// -------------------------------------------------------------

enum BatchStatus {
  ACTIVE
  NEAR_EXPIRY
  EXPIRED
  QUARANTINED
}

model MedicineBatch {
  id             BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  medicineId     BigInt      @map("medicine_id") @db.UnsignedBigInt
  batchNumber    String      @map("batch_number") @db.VarChar(100)
  mfgDate        DateTime?   @map("mfg_date") @db.Date
  expiryDate     DateTime    @map("expiry_date") @db.Date
  costPrice      Decimal     @map("cost_price") @db.Decimal(12, 2)
  sellingPrice   Decimal     @map("selling_price") @db.Decimal(12, 2)
  quantityOnHand Decimal     @default(0.000) @map("quantity_on_hand") @db.Decimal(12, 3)
  rackLocation   String?     @map("rack_location") @db.VarChar(100)
  status         BatchStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  medicine            Medicine              @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  stockMovements      StockMovement[]
  purchaseItems       PurchaseItem[]
  saleItems           SaleItem[]
  adjustmentItems     StockAdjustmentItem[]
  salesReturnItems    SalesReturnItem[]

  @@unique([medicineId, batchNumber], name: "uk_medicine_batch")
  @@index([expiryDate])
  @@index([status])
  @@map("medicine_batches")
}

enum MovementType {
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_DAMAGE
  ADJUSTMENT_LOST
  PHYSICAL_COUNT_VARIANCE
}

model StockMovement {
  id            BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  batchId       BigInt       @map("batch_id") @db.UnsignedBigInt
  movementType  MovementType @map("movement_type")
  quantityDelta Decimal      @map("quantity_delta") @db.Decimal(12, 3)
  balanceAfter  Decimal      @map("balance_after") @db.Decimal(12, 3)
  referenceType String       @map("reference_type") @db.VarChar(50)
  referenceId   BigInt       @map("reference_id") @db.UnsignedBigInt
  userId        BigInt       @map("user_id") @db.UnsignedBigInt
  note          String?      @db.VarChar(255)
  createdAt     DateTime     @default(now()) @map("created_at")

  batch MedicineBatch @relation(fields: [batchId], references: [id])
  user  User          @relation(fields: [userId], references: [id])

  @@index([batchId])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

enum AdjustmentReason {
  PHYSICAL_COUNT_VARIANCE
  DAMAGED_IN_STORE
  EXPIRED_DISPOSAL
  THEFT_OR_LOSS
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

model StockAdjustment {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  adjustmentNumber String           @unique @map("adjustment_number") @db.VarChar(50)
  reason           AdjustmentReason
  status           AdjustmentStatus @default(PENDING)
  createdBy        BigInt           @map("created_by") @db.UnsignedBigInt
  approvedBy       BigInt?          @map("approved_by") @db.UnsignedBigInt
  notes            String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  creator  User                  @relation("AdjCreatedBy", fields: [createdBy], references: [id])
  approver User?                 @relation("AdjApprovedBy", fields: [approvedBy], references: [id])
  items    StockAdjustmentItem[]

  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id               BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  adjustmentId     BigInt  @map("adjustment_id") @db.UnsignedBigInt
  batchId          BigInt  @map("batch_id") @db.UnsignedBigInt
  systemQuantity   Decimal @map("system_quantity") @db.Decimal(12, 3)
  physicalQuantity Decimal @map("physical_quantity") @db.Decimal(12, 3)
  variance         Decimal @db.Decimal(12, 3)
  unitCostSnapshot Decimal @map("unit_cost_snapshot") @db.Decimal(12, 2)

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  batch      MedicineBatch   @relation(fields: [batchId], references: [id])

  @@map("stock_adjustment_items")
}

// -------------------------------------------------------------
// 4. PROCUREMENT & SUPPLIERS
// -------------------------------------------------------------

model Supplier {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name           String   @db.VarChar(150)
  code           String?  @unique @db.VarChar(50)
  contactPerson  String?  @map("contact_person") @db.VarChar(100)
  phone          String   @db.VarChar(50)
  email          String?  @db.VarChar(100)
  address        String?  @db.Text
  paymentTerms   String?  @map("payment_terms") @db.VarChar(100)
  creditLimit    Decimal  @default(0.00) @map("credit_limit") @db.Decimal(12, 2)
  currentBalance Decimal  @default(0.00) @map("current_balance") @db.Decimal(12, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  purchases         Purchase[]
  payments          SupplierPayment[]
  purchaseReturns   PurchaseReturn[]
  suppliedMedicines Medicine[]        @relation("MedicinePrimarySupplier")

  @@index([name])
  @@map("suppliers")
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Purchase {
  id                 BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  purchaseNumber     String         @unique @map("purchase_number") @db.VarChar(50)
  supplierId         BigInt         @map("supplier_id") @db.UnsignedBigInt
  supplierInvoiceNo  String?        @map("supplier_invoice_no") @db.VarChar(100)
  status             PurchaseStatus @default(DRAFT)
  subtotal           Decimal        @default(0.00) @db.Decimal(12, 2)
  discountAmount     Decimal        @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount          Decimal        @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount        Decimal        @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  amountPaid         Decimal        @default(0.00) @map("amount_paid") @db.Decimal(12, 2)
  createdBy          BigInt         @map("created_by") @db.UnsignedBigInt
  receivedAt         DateTime?      @map("received_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  creator  User           @relation("PurchaseCreatedBy", fields: [createdBy], references: [id])
  items    PurchaseItem[]
  payments SupplierPayment[]

  @@index([supplierId])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  purchaseId       BigInt   @map("purchase_id") @db.UnsignedBigInt
  medicineId       BigInt   @map("medicine_id") @db.UnsignedBigInt
  batchId          BigInt?  @map("batch_id") @db.UnsignedBigInt
  batchNumber      String   @map("batch_number") @db.VarChar(100)
  expiryDate       DateTime @map("expiry_date") @db.Date
  orderedQuantity  Decimal  @map("ordered_quantity") @db.Decimal(12, 3)
  receivedQuantity Decimal  @default(0.000) @map("received_quantity") @db.Decimal(12, 3)
  bonusQuantity    Decimal  @default(0.000) @map("bonus_quantity") @db.Decimal(12, 3)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(12, 2)
  sellingPrice     Decimal  @map("selling_price") @db.Decimal(12, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(12, 2)

  purchase Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine Medicine       @relation(fields: [medicineId], references: [id])
  batch    MedicineBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@map("purchase_items")
}

enum SupplierPayMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
}

model SupplierPayment {
  id               BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  paymentNumber    String            @unique @map("payment_number") @db.VarChar(50)
  supplierId       BigInt            @map("supplier_id") @db.UnsignedBigInt
  purchaseId       BigInt?           @map("purchase_id") @db.UnsignedBigInt
  amount           Decimal           @db.Decimal(12, 2)
  paymentMethod    SupplierPayMethod @map("payment_method")
  paymentReference String?           @map("payment_reference") @db.VarChar(100)
  paidAt           DateTime          @default(now()) @map("paid_at")
  createdBy        BigInt            @map("created_by") @db.UnsignedBigInt

  supplier Supplier  @relation(fields: [supplierId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  creator  User      @relation("SupplierPaymentCreatedBy", fields: [createdBy], references: [id])

  @@map("supplier_payments")
}

model PurchaseReturn {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  returnNumber String   @unique @map("return_number") @db.VarChar(50)
  supplierId   BigInt   @map("supplier_id") @db.UnsignedBigInt
  totalAmount  Decimal  @map("total_amount") @db.Decimal(12, 2)
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  supplier Supplier             @relation(fields: [supplierId], references: [id])
  items    PurchaseReturnItem[]

  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  purchaseReturnId BigInt  @map("purchase_return_id") @db.UnsignedBigInt
  batchId          BigInt  @map("batch_id") @db.UnsignedBigInt
  returnQuantity   Decimal @map("return_quantity") @db.Decimal(12, 3)
  unitCost         Decimal @map("unit_cost") @db.Decimal(12, 2)
  lineTotal        Decimal @map("line_total") @db.Decimal(12, 2)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  @@map("purchase_return_items")
}

// -------------------------------------------------------------
// 5. CUSTOMERS, PATIENTS & PRESCRIPTIONS
// -------------------------------------------------------------

model Customer {
  id                      BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  customerCode            String?                 @unique @map("customer_code") @db.VarChar(50)
  name                    String                  @db.VarChar(150)
  birthday                DateTime?               @map("birthday") @db.Date
  gender                  Gender?                 @map("gender")
  phone                   String                  @unique @db.VarChar(30)
  email                   String?                 @db.VarChar(100)
  hasWhatsapp             Boolean                 @default(true) @map("has_whatsapp")
  whatsappNumber          String?                 @map("whatsapp_number") @db.VarChar(30)
  address                 String?                 @db.Text
  district                String?                 @db.VarChar(100)
  city                    String?                 @db.VarChar(100)
  familyMemberName        String?                 @map("family_member_name") @db.VarChar(150)
  familyMemberPhone       String?                 @map("family_member_phone") @db.VarChar(30)
  registrationSource      RegistrationSource      @default(MANUAL) @map("registration_source")
  status                  CustomerStatus          @default(ACTIVE) @map("status")
  phoneVerificationStatus PhoneVerificationStatus @default(VERIFIED) @map("phone_verification_status")
  privacyConsent          Boolean                 @default(true) @map("privacy_consent")
  whatsappConsent         Boolean                 @default(false) @map("whatsapp_consent")
  medicineReminderConsent Boolean                 @default(false) @map("medicine_reminder_consent")
  consentAt               DateTime?               @map("consent_at")
  outstandingBalance      Decimal                 @default(0.00) @map("outstanding_balance") @db.Decimal(12, 2)
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  patients         Patient[]
  sales            Sale[]
  notificationLogs NotificationLog[]

  @@index([phone])
  @@index([customerCode])
  @@index([registrationSource])
  @@index([status])
  @@map("customers")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum RegistrationSource {
  QR_CODE
  MANUAL
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum PhoneVerificationStatus {
  UNVERIFIED
  VERIFIED
  PENDING
}

model CustomerSequence {
  id         Int      @id @default(autoincrement())
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("customer_sequences")
}

model Patient {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  customerId        BigInt   @map("customer_id") @db.UnsignedBigInt
  fullName          String   @map("full_name") @db.VarChar(150)
  age               Int?     @db.UnsignedInt
  gender            Gender?
  knownAllergies    String?  @map("known_allergies") @db.Text
  chronicConditions String?  @map("chronic_conditions") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]

  @@map("patients")
}

enum PrescriptionStatus {
  PENDING_REVIEW
  VERIFIED
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

model Prescription {
  id                   BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  prescriptionCode     String             @unique @map("prescription_code") @db.VarChar(50)
  patientId            BigInt             @map("patient_id") @db.UnsignedBigInt
  doctorName           String             @map("doctor_name") @db.VarChar(150)
  doctorSlmcNo         String?            @map("doctor_slmc_no") @db.VarChar(50)
  prescriptionDate     DateTime           @map("prescription_date") @db.Date
  imageAttachmentUrl   String?            @map("image_attachment_url") @db.VarChar(255)
  status               PrescriptionStatus @default(PENDING_REVIEW)
  totalRefills         Int                @default(1) @map("total_refills") @db.UnsignedInt
  dispensedRefills     Int                @default(0) @map("dispensed_refills") @db.UnsignedInt
  clinicalNotes        String?            @map("clinical_notes") @db.Text
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])
  sales   Sale[]

  @@map("prescriptions")
}

// -------------------------------------------------------------
// 6. CASH SESSIONS, POINT OF SALE & SALES RETURNS
// -------------------------------------------------------------

enum SessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt        @map("user_id") @db.UnsignedBigInt
  openingFloat   Decimal       @map("opening_float") @db.Decimal(12, 2)
  closingAmount  Decimal?      @map("closing_amount") @db.Decimal(12, 2)
  expectedAmount Decimal?      @map("expected_amount") @db.Decimal(12, 2)
  variance       Decimal?      @db.Decimal(12, 2)
  status         SessionStatus @default(OPEN)
  notes          String?       @db.Text
  openedAt       DateTime      @default(now()) @map("opened_at")
  closedAt       DateTime?     @map("closed_at")

  user     User      @relation(fields: [userId], references: [id])
  sales    Sale[]
  expenses Expense[]

  @@index([userId, status])
  @@map("cash_sessions")
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Sale {
  id             BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  invoiceNumber  String     @unique @map("invoice_number") @db.VarChar(50)
  idempotencyKey String     @unique @map("idempotency_key") @db.VarChar(64)
  cashSessionId  BigInt     @map("cash_session_id") @db.UnsignedBigInt
  customerId     BigInt?    @map("customer_id") @db.UnsignedBigInt
  prescriptionId BigInt?    @map("prescription_id") @db.UnsignedBigInt
  cashierId      BigInt     @map("cashier_id") @db.UnsignedBigInt
  status         SaleStatus @default(COMPLETED)
  subtotal       Decimal    @db.Decimal(12, 2)
  discountAmount Decimal    @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal    @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  grandTotal     Decimal    @map("grand_total") @db.Decimal(12, 2)
  amountPaid     Decimal    @map("amount_paid") @db.Decimal(12, 2)
  changeAmount   Decimal    @default(0.00) @map("change_amount") @db.Decimal(12, 2)
  reprintCount   Int        @default(0) @map("reprint_count") @db.UnsignedInt
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  cashSession  CashSession   @relation(fields: [cashSessionId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  cashier      User          @relation("CashierSales", fields: [cashierId], references: [id])

  items        SaleItem[]
  payments     Payment[]
  salesReturns SalesReturn[]

  @@index([invoiceNumber])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  saleId           BigInt   @map("sale_id") @db.UnsignedBigInt
  medicineId       BigInt   @map("medicine_id") @db.UnsignedBigInt
  batchId          BigInt   @map("batch_id") @db.UnsignedBigInt
  unitId           BigInt?  @map("unit_id") @db.UnsignedBigInt
  quantity         Decimal  @db.Decimal(12, 3)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  unitCostSnapshot Decimal  @map("unit_cost_snapshot") @db.Decimal(12, 2)
  discountAmount   Decimal  @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(12, 2)

  sale             Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine         Medicine          @relation(fields: [medicineId], references: [id])
  batch            MedicineBatch     @relation(fields: [batchId], references: [id])
  unit             MedicineUnit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  salesReturnItems SalesReturnItem[]

  @@map("sale_items")
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  LANKAPAY_QR
  BANK_TRANSFER
  STORE_CREDIT
}

enum PaymentStatus {
  SUCCESS
  FAILED
  REVERSED
}

model Payment {
  id            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  saleId        BigInt        @map("sale_id") @db.UnsignedBigInt
  paymentMethod PaymentMethod @map("payment_method")
  amount        Decimal       @db.Decimal(12, 2)
  referenceCode String?       @map("reference_code") @db.VarChar(100)
  status        PaymentStatus @default(SUCCESS)
  createdAt     DateTime      @default(now()) @map("created_at")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum RefundMethod {
  CASH
  STORE_CREDIT
}

model SalesReturn {
  id           BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  returnNumber String       @unique @map("return_number") @db.VarChar(50)
  saleId       BigInt       @map("sale_id") @db.UnsignedBigInt
  reason       String       @db.VarChar(255)
  refundTotal  Decimal      @map("refund_total") @db.Decimal(12, 2)
  refundMethod RefundMethod @map("refund_method")
  processedBy  BigInt       @map("processed_by") @db.UnsignedBigInt
  approvedBy   BigInt       @map("approved_by") @db.UnsignedBigInt
  createdAt    DateTime     @default(now()) @map("created_at")

  sale        Sale              @relation(fields: [saleId], references: [id])
  processor   User              @relation("ReturnProcessedBy", fields: [processedBy], references: [id])
  approver    User              @relation("ReturnApprovedBy", fields: [approvedBy], references: [id])
  returnItems SalesReturnItem[]

  @@map("sales_returns")
}

enum RestockStatus {
  RESTOCKED
  QUARANTINED
  DISCARDED
}

model SalesReturnItem {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  salesReturnId  BigInt        @map("sales_return_id") @db.UnsignedBigInt
  saleItemId     BigInt        @map("sale_item_id") @db.UnsignedBigInt
  batchId        BigInt        @map("batch_id") @db.UnsignedBigInt
  returnQuantity Decimal       @map("return_quantity") @db.Decimal(12, 3)
  refundAmount   Decimal       @map("refund_amount") @db.Decimal(12, 2)
  restockStatus  RestockStatus @map("restock_status")

  salesReturn SalesReturn   @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  saleItem    SaleItem      @relation(fields: [saleItemId], references: [id])
  batch       MedicineBatch @relation(fields: [batchId], references: [id])

  @@map("sales_return_items")
}

// -------------------------------------------------------------
// 7. EXPENSES, NOTIFICATIONS & SETTINGS
// -------------------------------------------------------------

model ExpenseCategory {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id                   BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  categoryId           BigInt   @map("category_id") @db.UnsignedBigInt
  cashSessionId        BigInt?  @map("cash_session_id") @db.UnsignedBigInt
  amount               Decimal  @db.Decimal(12, 2)
  description          String   @db.VarChar(255)
  voucherAttachmentUrl String?  @map("voucher_attachment_url") @db.VarChar(255)
  createdBy            BigInt   @map("created_by") @db.UnsignedBigInt
  expenseDate          DateTime @map("expense_date") @db.Date
  createdAt            DateTime @default(now()) @map("created_at")

  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  cashSession CashSession?    @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  creator     User            @relation(fields: [createdBy], references: [id])

  @@map("expenses")
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model NotificationLog {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  customerId        BigInt?             @map("customer_id") @db.UnsignedBigInt
  channel           NotificationChannel @default(WHATSAPP)
  recipientPhone    String              @map("recipient_phone") @db.VarChar(30)
  templateName      String              @map("template_name") @db.VarChar(100)
  payload           Json
  providerMessageId String?             @map("provider_message_id") @db.VarChar(150)
  status            NotificationStatus  @default(QUEUED)
  errorMessage      String?             @map("error_message") @db.Text
  sentAt            DateTime?           @map("sent_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([providerMessageId])
  @@map("notification_logs")
}

model PharmacySetting {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  settingKey  String   @unique @map("setting_key") @db.VarChar(100)
  settingValue String   @map("setting_value") @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("pharmacy_settings")
}

