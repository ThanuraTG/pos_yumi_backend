# ==============================================================================
# PharmaSys POS - Backend Environment Configuration Template (.env.example)
# Duplicate this file as .env and adjust values according to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="PharmaSys"
APP_VERSION="1.0.0"
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173,https://pos.pharmacy.lk"

# ------------------------------------------------------------------------------
# 2. SWAGGER / OPENAPI DOCUMENTATION
# ------------------------------------------------------------------------------
SWAGGER_PATH="docs"
SWAGGER_TITLE="PharmaSys Pharmacy Management REST API"
SWAGGER_DESCRIPTION="Complete Pharmacy POS, FEFO Batch Inventory, GRN Procurement, and Shift Management REST API"

# ------------------------------------------------------------------------------
# 3. RATE LIMITING (Throttler)
# ------------------------------------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ------------------------------------------------------------------------------
# 4. DATABASE SETTINGS (MySQL 8.4 LTS InnoDB via Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://pharmasys_user:pharmasys_secure_pass@127.0.0.1:3306/pharmasys_db?schema=public&connection_limit=25"

# ------------------------------------------------------------------------------
# 5. JWT AUTHENTICATION SECRETS & COOKIES
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="CHANGE_THIS_TO_A_64_CHAR_HEX_SECRET_FOR_PRODUCTION_ACCESS_TOKEN"
JWT_ACCESS_EXPIRATION="24h"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_A_64_CHAR_HEX_SECRET_FOR_PRODUCTION_REFRESH_TOKEN"
JWT_REFRESH_EXPIRATION="30d"
JWT_REFRESH_COOKIE_DAYS=30
COOKIE_SAME_SITE="strict"

# ------------------------------------------------------------------------------
# 6. REDIS CONFIGURATION (BullMQ Background Queue)
# ------------------------------------------------------------------------------
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# 7. META WHATSAPP BUSINESS CLOUD API
# ------------------------------------------------------------------------------
WHATSAPP_API_URL="https://graph.facebook.com/v19.0"
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"
WHATSAPP_WABA_ID="YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID"
WHATSAPP_ACCESS_TOKEN="YOUR_PERMANENT_META_SYSTEM_USER_TOKEN"
WHATSAPP_APP_SECRET="YOUR_META_APP_SECRET"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="YOUR_CUSTOM_WEBHOOK_VERIFICATION_TOKEN"
WHATSAPP_WEBHOOK_URL="https://api.pharmasys.lk/api/v1/notifications/whatsapp/webhook"
WHATSAPP_RATE_LIMIT_PER_SEC=10

# ------------------------------------------------------------------------------
# 8. PHARMACY PROFILE & LOCALIZATION
# ------------------------------------------------------------------------------
PHARMACY_NAME="PharmaSys Retail Pharmacy"
PHARMACY_ADDRESS="124 Galle Road, Colombo 03, Sri Lanka"
PHARMACY_PHONE="+94 11 234 5678"
PHARMACY_EMAIL="info@pharmasys.lk"
PHARMACY_SLMC_NO="SLMC-PH-2024-8891"
PHARMACY_TAX_NO="TIN-409182390"
DEFAULT_CURRENCY="LKR"
DEFAULT_TIMEZONE="Asia/Colombo"
DEFAULT_RECEIPT_WIDTH="80mm"
RECEIPT_HEADER_NOTE="Trust in Care & Wellness"
RECEIPT_FOOTER_NOTE="Thank you for your visit. Get well soon! Medicines once sold are non-returnable unless recalled."

# ------------------------------------------------------------------------------
# 9. DOCUMENT CODE PREFIXES
# ------------------------------------------------------------------------------
CUSTOMER_CODE_PREFIX="CUS"
INVOICE_PREFIX="INV"
PO_PREFIX="PO"
GRN_PREFIX="GRN"
SALES_RETURN_PREFIX="RET"
PURCHASE_RETURN_PREFIX="PR"
SKU_PREFIX="MED"

# ------------------------------------------------------------------------------
# 10. DEFAULT SEED ADMINISTRATOR
# ------------------------------------------------------------------------------
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_EMAIL="admin@pharmasys.lk"
DEFAULT_ADMIN_PASSWORD="Admin@123456"
